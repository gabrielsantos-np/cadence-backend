# Copy to .env and fill in. Never commit .env.

# Application
APP_NAME="Cadence API"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Required to answer questions. Without it the service still starts and
# /health passes; the analyst reports that it cannot run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# --- Conversation storage -----------------------------------------------
# Chat history lives in Postgres. `make db-up` starts one matching these
# defaults; point DATABASE_URL at Supabase to host it instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/market

# --- Market data ---------------------------------------------------------
# The analyst's connection. Separate from DATABASE_URL, deliberately: the
# analyst writes its own SQL, so it connects as a role that can only read
# market data. The security boundary is the database role, not this
# application — never point this at the same role as DATABASE_URL.
ANALYST_DATABASE_URL=postgres://analyst_ro:analyst_ro@localhost:5432/market

# Password for the read-only role that `make db-load` creates. Leave unset for
# local development; always set it on a hosted database, which is reachable
# from the internet.
ANALYST_DB_PASSWORD=

# --- Snowflake -----------------------------------------------------------
# Used when MARKET_SOURCE=snowflake. Conversation storage stays on Postgres
# either way.

# Which warehouse the analyst queries for market data: postgres | snowflake
MARKET_SOURCE=postgres

# The account IDENTIFIER, not the hostname: the "xy12345.us-east-1" part of
# your Snowflake URL, without ".snowflakecomputing.com".
SNOWFLAKE_ACCOUNT=

# Admin credentials. Used ONLY by `make snowflake-setup` to create the
# database, role, user and grants. Never used to serve a request.
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=
SNOWFLAKE_ADMIN_ROLE=ACCOUNTADMIN

# The analyst's own login. Created by the setup script: a dedicated user whose
# only role is SELECT on the market schema. The analyst writes its own SQL, so
# the privilege boundary has to be Snowflake's, not this application's — a
# separate user means "USE ROLE ACCOUNTADMIN" cannot escalate.
SNOWFLAKE_USER=CADENCE_ANALYST
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=CADENCE_ANALYST_RO

# Password the setup script assigns to that user. Choose a strong one.
SNOWFLAKE_ANALYST_PASSWORD=

SNOWFLAKE_DATABASE=CADENCE
SNOWFLAKE_SCHEMA=MARKET
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
