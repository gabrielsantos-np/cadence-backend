# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Scratch files that may hold credentials
*.tmp

# Generated corpus. Deterministic from scripts/generate_corpus.py, so the
# script is the artefact and 12MB of output is not.
data/corpus/
data/bench_results.json

# Acceptance run output. The cases are the artefact and are tracked; a
# particular run's results are a timestamp, and they contain the full text of
# any failing answer.
data/acceptance_results.json

# Tooling caches
.pytest_cache/
.ruff_cache/

# Generated from the warehouse by scripts/gen_market_truth.py — the generator
# is the artefact, and the cases change whenever the data does.
data/market_truth_cases.json
data/snowflake_truth_cases.json
